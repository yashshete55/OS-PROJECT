# ─── Hardware Introspection Agent — Environment Configuration ───
# Copy this file to .env and fill in your API key.

# Google Gemini is the default provider for conversational tool calling.
LLM_PROVIDER=google

# Never commit a real key. Create .env locally and replace this placeholder.
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Command timeout in seconds
COMMAND_TIMEOUT=10

# Set to "true" to mask serial numbers in output
MASK_SERIALS=false
